# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - see docs/configuration.md for what every one
# of these means and how to choose a value.

# --- Login accounts ---------------------------------------------------
# JSON object: one entry per login, "role" is either "admin" or "user".
# Keep this on one line.
CBGP_USERS={"someadmin":{"password":"change-me","role":"admin"},"someuser":{"password":"change-me","role":"user"}}

# Long random string used to sign session cookies. Generate one with, e.g.:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
CBGP_SECRET=change-me-to-a-long-random-string

# --- Ontology ------------------------------------------------------------
# Where the application reads its OWL ontology from. The public default
# below is correct for almost everyone - only change this if running a
# private fork of the ontology.
CBGP_KB=https://w3id.org/CBGP-App

# --- Virtuoso (see installation.md for standing up the two containers) ---
# Two separate Virtuoso instances, not one - see configuration.rb for why
# (physically separate current-state and history stores). VIRTUOSO_USER is
# almost always "dba" (Virtuoso's built-in superuser; this project doesn't
# provision a separate least-privilege SPARQL role yet). VIRTUOSO_PASS also
# becomes each container's DBA_PASSWORD in docker-compose.yml, so it's the
# same value in both places - set it once, here.
VIRTUOSO_HOST=localhost:18890
VIRTUOSO_USER=dba
VIRTUOSO_PASS=change-me
VIRTUOSO_HISTORY_HOST=localhost:18891
# Optional: only set these if the history store uses different credentials
# than the current-state one. Usually it doesn't, so these are normally left
# unset (they default to VIRTUOSO_USER/VIRTUOSO_PASS).
#HISTORY_USER=
#HISTORY_PASS=

# --- Admin email notifications ------------------------------------------
# Sent whenever a User submits something through the public-facing forms
# (see user_guide.md). NOTIFY_TO may be a single address or a
# comma-separated list.
NOTIFY_TO=admin@example.org
NOTIFY_FROM=cbgp-databases@example.org
NOTIFY_UN=change-me
NOTIFY_PW=change-me
NOTIFY_SMTP_ADDRESS=smtp.example.org
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_STARTTLS=true
NOTIFY_SMTP_AUTH=login

# --- MCP query servers (/mcp/core, /mcp/history) -------------------------
# Shared bearer tokens an MCP client sends as "Authorization: Bearer
# <token>" - see lib/mcp_auth.rb. Deliberately the simplest auth that still
# fails closed: these endpoints only ever run behind the institute
# firewall/VPN. Two separate tokens, not one, so either can be revoked/
# rotated independently. Generate each with, e.g.:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
CORE_MCP_TOKEN=change-me-to-a-long-random-string
HISTORY_MCP_TOKEN=change-me-to-a-long-random-string
