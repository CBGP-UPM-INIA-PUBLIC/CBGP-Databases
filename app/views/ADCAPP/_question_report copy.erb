        

      <!-- incoming @question is the thing like "does your child do this or that" -->
      <!-- [:answerblock, :questionid=, :sequence=, :questionid, :sequence, :question, :answerblock=, :question=, :lang, :lang=] -->

      <div id="<%= @question.questionid %>" style="clear: both">

        <h4 style="float: left"><%= @question.question %></h4>
        <span style="float: left; clear: both;">
        <% @question.selected_answer.each  do |answer| %>
            <p><%= answer %></p>
        <% end %>

        <br/><br/>

      </div>