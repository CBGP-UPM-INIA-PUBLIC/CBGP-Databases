<!DOCTYPE html>
<!--[if lt IE 7]> <html class="no-js ie6 oldie" lang="en"> <![endif]-->
<!--[if IE 7]>    <html class="no-js ie7 oldie" lang="en"> <![endif]-->
<!--[if IE 8]>    <html class="no-js ie8 oldie" lang="en"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js" lang="en"> <!--<![endif]-->
  
  <%= erb :_head %>

  <body>
  <center>
    <div><img src="https://www.worldduchenne.org/wp-content/uploads/wdo_logo_large.png" width="400px"/>
    </div>
  </center>
    <div style="clear: both;">
      <br/><br/>

      <h1>Accredited Duchenne Centers Questionnaire: Add ADC Comments to Submission </h1>
      <br/>
    </div>

    <div class="questionnairelist">
      <center> <!-- name: name, email: email, applicant: applicant, country: country, id: id, graph: graph) -->
      <h3>Center Name: <%= @center.name %></h3>
      <h4>Center ID: <%= @center.id %><br/></h4>
      <h4>Country: <%= @center.country %><br/></h4>
      <h4>E-mail: <%= @center.email %></h4>
      <br/><br/>
      </center>

      <form action="/adc/submit-comments" method="post">
        <input type="hidden" name="questionnaireid" value="<%= @questionnaire.questionnaireid %>"/>
        <input type="hidden" name="center" value="<%= @center.id %>"/>
        
        <div style="clear: both;">

              <div class="" style="">
                <% sections = @questionnaire.sections %>
                
                <% sections.each do |sect| %>
                  <% @section = sect %>
                  <%= erb :_section_report %>
                <% end %>
              </div>

              <br/><br/><br/>
        </div>
        <input type="submit" value="Save These Comments"/>
      </form>
    </div>

    <div style="clear: both;">
    <%= erb :_footer %>
    </div>


    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
    <!--[if lt IE 7]>
      <script src="//ajax.googleapis.com/ajax/libs/chrome-frame/1.0.2/CFInstall.min.js"></script>
      <script>window.attachEvent("onload",function(){CFInstall.check({mode:"overlay"})})</script>
    <![endif]-->
  </body>
</html>


