<!DOCTYPE html>
<!--[if lt IE 7]> <html class="no-js ie6 oldie" lang="en"> <![endif]-->
<!--[if IE 7]>    <html class="no-js ie7 oldie" lang="en"> <![endif]-->
<!--[if IE 8]>    <html class="no-js ie8 oldie" lang="en"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js" lang="en"> <!--<![endif]-->
  
  <%= erb :_head %>

  <body>
  <script>
    function openActionPanel(cid) {
      var x = document.getElementById(cid);
      if (x.style.display === "none") {
        x.style.display = "block";
      } else {
        x.style.display = "none";
      }
    }
  </script>

  
      <%= erb :_logo_head %>



    <div style="clear: both;">
      <br/><br/>

      <h1>Accredited Duchenne Centers - Hidden Centers</h1>
      <br/>
    </div>

    <div class="centerlist">

    <table id="centers" width="100%">
      <tr> <th>Status</th><th>Center Name</th><th>Applicant</th><th>E-mail</th><th>Country</th><th>Action</th> </tr>
      <% @centers.each do |c| %>
        <% next unless c.visibility == "hidden" %>
        <% @center = c %> <!-- to pass to _actions -->
        <tr><td title="OPEN - No questionnaire sent; Q = Date last questionnaire was generated; A = Date last response was received; C = Date last comments were sent to center; R = Date last comment responses were received" ><%= c.status %></td><td><%= c.name %></td><td><%= c.applicant %></td><td><%= c.email %></td><td><%= c.country %></td><td><img onclick="openActionPanel('<%= c.id %>')" src="/images/arrow-down.png"></td></tr>
        <tr><td colspan=5><div id="<%= c.id %>" style="display: none;"><%= erb :_unhide %></div></td></tr>
      <% end %>
    </table>
    </div>


    <div style="clear: both;">
      <%= erb :_footer %>
    </div>


    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
    <!--[if lt IE 7]>
      <script src="//ajax.googleapis.com/ajax/libs/chrome-frame/1.0.2/CFInstall.min.js"></script>
      <script>window.attachEvent("onload",function(){CFInstall.check({mode:"overlay"})})</script>
    <![endif]-->
  </body>
</html>


