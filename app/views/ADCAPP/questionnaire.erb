<!DOCTYPE html>
<!--[if lt IE 7]> <html class="no-js ie6 oldie" lang="en"> <![endif]-->
<!--[if IE 7]>    <html class="no-js ie7 oldie" lang="en"> <![endif]-->
<!--[if IE 8]>    <html class="no-js ie8 oldie" lang="en"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js" lang="en"> <!--<![endif]-->
  
  <%= erb :_head %>

  <body>

  <%= erb :_warning_popup %>



  
      <%= erb :_logo_head %>



    <div style="clear: both;">
      <br/><br/>

      <h1>Accredited Duchenne Centers Questionnaire</h1>
      <br/>
    </div>


    <form action="/adc/submit-answers" method="post">
    <input type="hidden" name="center" value="<%= @center %>"/>
    <input type="hidden" name="patprof" value="<%= @questionnaire.patprof %>"/>
    <input type="hidden" name="adultchild" value="<%= @questionnaire.adultchild %>"/>
    <input type="hidden" name="qtype" value="<%= @questionnaire.questionnaire_type %>"/>
    <input type="hidden" name="lang" value="<%= @questionnaire.lang %>"/>
    

      <center><b style="font-size: 1.7em;">Please answer as many questions as possible.<br/>If you answer "other" or wish to provide additional details,<br/>please use the "Comments" box at the end of each section.
      </b></center>

      
      <div style="clear: both;">

            <div class="" style="">
              <% sections = @questionnaire.sections %>
              
              <% sections.each do |sect| %>
                <% @section = sect %>
                <%= erb :_section %>
              <% end %>
            </div>

            <br/><br/><br/>
      </div>
      <input type="submit" value="Submit These Responses"/>
    </form>

    <div style="clear: both;">
    <%= erb :_footer %>
    </div>


    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
    <!--[if lt IE 7]>
      <script src="//ajax.googleapis.com/ajax/libs/chrome-frame/1.0.2/CFInstall.min.js"></script>
      <script>window.attachEvent("onload",function(){CFInstall.check({mode:"overlay"})})</script>
    <![endif]-->
  </body>
</html>


