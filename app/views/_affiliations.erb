<% if @thisval.empty? %>
          <div class="affiliation">
          <input 
          type='text' 
          name="<%= @question.questionid  %>[]" 
          id="<%= @question.questionid  %>" 
          size="70"/>
          </div>
<% else %>

      <% @thisval.each do |aff|  %>

          <div class="affiliation">
          <input 
          type='text' 
          name="<%= @question.questionid  %>[]" 
          value="<%= aff %>" 
          id="<%= @question.questionid  %>" 
          size="<%= aff.length %>"/>
          </div>

      <% end %>
<% end %>