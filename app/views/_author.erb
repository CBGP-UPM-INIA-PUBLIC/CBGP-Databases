
<!-- @thisval is coming straight from openAIRE: {"@rank"=>"1", "@orcid"=>"0000-0003-1917-6789", "$"=>"Matthew G. Links"}" -->
          <div class="inputtype">
          <label for="<%= @label  %>_NAME" style="font-size: .75em;">Name: </label><br/>
          <input type='text' 
                name="<%= @label  %>" 
                value="<%= @thisval["$"] %>" 
                id="<%= @label  %>_NAME" 
                size="<%= @thisval["$"].length %>"/>
          </div>


          <div class="inputtype">
          <label for="<%= @label  %>_ORCID" style="font-size: .75em;">ORCiD</label><br/>
          <input type='text' 
                name="<%= @label  %>" 
                value="<%= @thisval["@orcid"] %>" 
                id="<%= @label  %>_ORCID" 
                size="<%= @thisval["@orcid"].length %>"/>
          </div>


