<% @thisval.each do |auth|  %>
            <div id="authorlist" class="authorlist">
            <!-- PUT FORM FIELDS IN HERE?  -->

                  <div class="author">
                        <label for="<%= @question.questionid  %>_NAME" style="font-size: .75em;">Name: </label><br/>
                        <input type="hidden" name = "<%= @question.questionid  %>_RANK" value="<%= auth.rank %>"/>
                        <input type='text' 
                              name="<%= @question.questionid  %>_NAME[]" 
                              value="<%= auth.name %>" 
                              id="<%= @question.questionid  %>_NAME" 
                              size="<%= auth.name.length %>"/>
                  </div>


                  <div class="author">
                        <label for="<%= @question.questionid  %>_ORCID" style="font-size: .75em;">ORCiD: </label><br/>
                        <input type='text' 
                              name="<%= @question.questionid  %>_ORCID[]" 
                              value="<%= auth.orcid %>" 
                              id="<%= @question.questionid  %>_ORCID" 
                              size="20"/>
                  </div>
                  <br/><br/>
            </div>


<% end %>