<% 
  # Get the date value (replace @answerblock[:answers] with your actual variable)
  date_value = extract_date(@thisval)
  # Ensure date is in YYYY-MM-DD format for input type="date"
  formatted_date = date_value.match(/\d{4}-\d{2}-\d{2}/) ? date_value : ''
%>
<div class="inputtype">
    <label for=<%= @answerblock.ablockid  %> style="font-size: .75em;">
    </label><br/>
    <input type="date" name="<%= @question.questionid  %>" id="<%= @answerblock.ablockid  %>" value="<%= formatted_date %>">
    <%# fills the box with today's date; the date itself is what gets saved (today.js) %>
    <button type="button" class="today-button" data-fill-today><%= CGI.escapeHTML(ui_text('entry.today')) %></button>
  </div>