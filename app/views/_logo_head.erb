<div style="clear: both;">

  <center>
    <div><a href="/cbgp/dashboard"><img src="/images/logo_CBGP.jpg" width="200px"/></a>
    </div>
    <a href="/cbgp/logout"><input type="submit" value="LOGOUT"/></a><br/>

<label for="cars" style="color: white;">Language/Lengua</label>

<select name="language" id="language-select" onchange="setLanguage()">
  <option value="en" <%= 'selected' if $language == 'en' %>>EN</option>
  <option value="es" <%= 'selected' if $language == 'es' %>>ES</option>
</select>

<script>
  function setLanguage() {
    const select = document.getElementById('language-select');
    const language = select.value;
    fetch('/set_language', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `language=${language}`
    }).then(() => {
      // Optionally reload the page to reflect changes
      window.location.reload();
    });
  }
</script>


  </center>
</div>
