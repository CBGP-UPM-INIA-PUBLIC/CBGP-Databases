<!-- questionid, :sequence, :objectclass, :objectmethod, :answerblock, :answertree, :question, 
     :selected_answer, :widget, :cardinality -->

<% label = @question.question %>
<div id="<%= label %>" class="field-row" style="clear: both;">
  <h4 class="question-label"><%= label %></h4>
  <% widget = @question.widget.match(/.*\#(\S+)/)[1] %>
  <% warn "Widget for #{@question.questionid}: #{@question.widget}" %>
  <% warn "Extracted widget: #{widget}" %>
  <% warn "Cardinality for #{@question.questionid}: #{@question.cardinality}" %>

  <!-- Initialize @value based on mode -->
  <% if @mode == 'search' %>
    <% @value = "" %>
    <% @value = [@value] unless @value.is_a?(Array) %>
    <% @answerblock = @question.answerblock %>
    <% @hierarchical_data = @question.answertree %>
    <% @value.each do |val| %>
      <% @thisval = val %>
      <% if widget == "date" %>
        <%= erb :_search_date %>
      <% else %>
        <%= erb "_search_#{widget}".to_sym %>
      <% end %>
    <% end %>
  <% else %> <!-- Assume add/edit mode -->
    <% @value = @entry.public_send(@question.objectmethod) || (@question.cardinality == "Multiple" ? [""] : "") %>
    <% warn "Question #{@question.questionid}: objectmethod=#{@question.objectmethod}, value=#{@value.inspect}" %>
    <% @answerblock = @question.answerblock %>
    <% @hierarchical_data = @question.answertree %>
    <% if @question.cardinality == "Multiple" %>
      <% @thisval = @value %>
      <%= erb "_#{widget}".to_sym %>
    <% else %>
      <% @value = [@value] unless @value.is_a?(Array) %>
      <% @value.each do |val| %>
        <% @thisval = val %>
        <%= erb "_#{widget}".to_sym %>
      <% end %>
    <% end %>
  <% end %>
</div>