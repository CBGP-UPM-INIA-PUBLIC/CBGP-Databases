<!-- @answerblock [:type, :answers, :lang=, :lang, :ablockid=, :answers=, :type=, :ablockid] -->     

<div class="inputtype">
  <select name="<%= @question.questionid %>" id="<%= @answerblock.ablockid %>" style="width: 50%;">
    <option hidden disabled value selected> -- select an option -- </option>
    <% @answerblock.answers.each do |answer| %>
      <% selected = (@thisval == answer.answerid) ? "selected=\"selected\"" : "" %>
      <option value="<%= answer.answerid %>" <%= selected %>><%= answer.answer %></option>
    <% end %>
  </select>
</div>