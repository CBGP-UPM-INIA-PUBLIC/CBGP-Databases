<!-- _reference_typeahead.erb -->
<!-- Expects locals: question, value (current @thisval), target (e.g. "member") -->
<%
  qid        = question.questionid
  via        = question.references_via_class.to_s
  label_meth = question.references_label_method.to_s
  is_xref    = !via.strip.empty?

  # What the box searches, in the ontology's own words (e.g. "Surname(s)" for a
  # member, "Title of the project" for a project) - so the placeholder says
  # exactly what to type, and that nothing happens before 2 characters.
  # The thing searched is named by its ontology label in the user's language
  # ("miembro", not the class name "member"); the hint text itself is interface
  # text, also from the ontology (ui_typeahead_hint*). A target with no label of
  # its own (e.g. a bare storage name such as "project") is left out of the
  # hint rather than shown as a raw class name.
  target_name = begin
    named = cached_label_for_id(id: target.to_s)
    named.to_s.empty? || named == target.to_s ? nil : named.downcase
  rescue StandardError
    nil
  end
  std_hint  = target_name ? ui_text('typeahead.hint', target: target_name) : ui_text('typeahead.hint_plain')
  xref_hint = std_hint
  if is_xref
    begin
      searched = CBGP::Dataset.fields_for(target).find { |f| f[:questionclass] == label_meth }
      if searched
        xref_hint = target_name ? ui_text('typeahead.hint_field', field: searched[:label], target: target_name) : ui_text('typeahead.hint_field_plain', field: searched[:label])
      end
    rescue StandardError
      nil # fall back to the generic hint
    end
  end
  is_multi   = question.cardinality == 'Multiple'

  # Normalise existing stored values into an array; always at least one (possibly empty) row
  stored_values = Array(value).map(&:to_s).map(&:strip)
  stored_values = [''] if stored_values.empty?
  stored_values = [stored_values.first] unless is_multi
%>
<% warn "Rendering typeahead for #{qid} | xref=#{is_xref} multi=#{is_multi} values=#{stored_values.inspect}" %>

<div class="reference-input-wrapper">
  <label><%= question.question %></label>

  <% if !is_xref %>
    <!-- ================================================================
         STANDARD TYPEAHEAD  (label = stored value, optional multiple)
         ================================================================ -->
    <% stored_values.each_with_index do |sv, idx| %>
    <div class="std-row" id="<%= qid %>_row_<%= idx %>">
      <input
        type="text"
        name="<%= qid %><%= is_multi ? '[]' : '' %>"
        id="<%= qid %>_ANSWER_<%= idx %>"
        value="<%= CGI.escapeHTML(sv) %>"
        placeholder="<%= CGI.escapeHTML(std_hint) %>"
        size="60"
        autocomplete="off"
      />
      <% if is_multi && idx > 0 %>
        <button type="button" onclick="this.closest('.std-row').remove()" style="font-size:0.8em;">− <%= CGI.escapeHTML(ui_text('typeahead.remove')) %></button>
      <% end %>
    </div>
    <% end %>

    <% if is_multi %>
      <button type="button" id="<%= qid %>_add_btn" style="margin-top:4px;">+ <%= CGI.escapeHTML(ui_text('typeahead.add_another')) %></button>
    <% end %>

    <script>
    (function() {
      const targetForm = '<%= target %>';
      const qid        = '<%= qid %>';

      // Attach the suggestion list to every existing row, and to new rows added later.
      // (typeahead.js: the list shows exactly what the server returns.)
      function attachStdListener(input) {
        CBGPSuggest.attach(input, {
          fetchItems: function(query) {
            return fetch(`/cbgp/reference/suggest/${encodeURIComponent(targetForm)}?q=${encodeURIComponent(query)}&via=&label_method=`)
              .then(r => r.json());
          },
          onPick: function(item) { input.value = item.value; }   // here the stored text IS the value
        });
      }

      document.querySelectorAll('[id^="<%= qid %>_ANSWER_"]').forEach(attachStdListener);

      <% if is_multi %>
      let rowCount = <%= stored_values.size %>;
      document.getElementById('<%= qid %>_add_btn').addEventListener('click', function() {
        const container = this.parentElement;
        const row = document.createElement('div');
        row.className = 'std-row';
        row.id = qid + '_row_' + rowCount;
        row.innerHTML = `
          <input type="text" name="${qid}[]" id="${qid}_ANSWER_${rowCount}"
                 placeholder="<%= CGI.escapeHTML(std_hint) %>"
                 size="60" autocomplete="off">
          <button type="button" onclick="this.closest('.std-row').remove()" style="font-size:0.8em;">− <%= CGI.escapeHTML(ui_text('typeahead.remove')) %></button>`;
        container.insertBefore(row, this);
        attachStdListener(document.getElementById(qid + '_ANSWER_' + rowCount));
        rowCount++;
      });
      <% end %>
    })();
    </script>

  <% else %>
    <!-- ================================================================
         CROSS-REFERENCE TYPEAHEAD  (search by label, store different value)
         ================================================================ -->
    <div id="<%= qid %>_container" data-row-count="<%= stored_values.size %>">

      <% stored_values.each_with_index do |sv, idx| %>
      <div class="xref-row" id="<%= qid %>_row_<%= idx %>">
        <div>
          <input type="text" id="<%= qid %>_SEARCH_<%= idx %>"
                 placeholder="<%= CGI.escapeHTML(xref_hint) %>"
                 size="50" autocomplete="off">
          <% if is_multi %>
            <button type="button" onclick="this.closest('.xref-row').remove()" style="font-size:0.8em; margin-left:4px;">− <%= CGI.escapeHTML(ui_text('typeahead.remove')) %></button>
          <% end %>
        </div>
        <div id="<%= qid %>_stored_row_<%= idx %>"
             style="margin-top:4px;<%= sv.empty? ? ' display:none' : '' %>">
          <small><%= CGI.escapeHTML(ui_text('typeahead.stored_value')) %>:&nbsp;</small>
          <code id="<%= qid %>_DISPLAY_<%= idx %>"><%= CGI.escapeHTML(sv) %></code>
          <span id="<%= qid %>_LABEL_<%= idx %>" class="xref-label"></span>
          <button type="button" id="<%= qid %>_CLEAR_<%= idx %>"
                  style="margin-left:6px; font-size:0.8em;">✕ <%= CGI.escapeHTML(ui_text('typeahead.clear')) %></button>
        </div>
        <input type="hidden"
               name="<%= qid %><%= is_multi ? '[]' : '' %>"
               id="<%= qid %>_ANSWER_<%= idx %>"
               value="<%= CGI.escapeHTML(sv) %>">
      </div>
      <% end %>

    </div><!-- /#container -->

    <% if is_multi %>
      <button type="button" id="<%= qid %>_add_btn" style="margin-top:4px;">+ <%= CGI.escapeHTML(ui_text('typeahead.add_another')) %></button>
    <% end %>

    <script>
    (function() {
      const qid        = '<%= qid %>';
      const targetForm = '<%= target %>';
      const via        = '<%= via %>';
      const labelMeth  = '<%= label_meth %>';
      const xrefHint   = <%= xref_hint.to_json.gsub('</', '<\\/') %>;

      // Initialise one cross-ref row by its numeric suffix.
      // Each call gets its own suggestion list — no sharing.
      function initXrefRow(suffix) {
        const input       = document.getElementById(qid + '_SEARCH_'     + suffix);
        const hiddenInput = document.getElementById(qid + '_ANSWER_'     + suffix);
        const displayEl   = document.getElementById(qid + '_DISPLAY_'    + suffix);
        const labelEl     = document.getElementById(qid + '_LABEL_'      + suffix);
        const storedRow   = document.getElementById(qid + '_stored_row_' + suffix);
        const clearBtn    = document.getElementById(qid + '_CLEAR_'      + suffix);

        // labelText is omitted when the caller doesn't know it yet (kept as
        // whatever was already shown) - see the initial-load lookup below.
        function setStoredValue(val, labelText) {
          hiddenInput.value     = val;
          displayEl.textContent = val;
          storedRow.style.display = val ? '' : 'none';
          if (labelEl && labelText !== undefined) {
            labelEl.textContent = labelText ? `(${labelText})` : '';
          }
        }

        clearBtn.addEventListener('click', function() {
          setStoredValue('', '');
          input.value = '';
        });

        // On page load, a row may already carry a stored value (e.g. an
        // ORCID saved on a previous visit) with no label ever fetched for
        // it - the server only knows the raw stored value, not the
        // cross-referenced record's display name. Look it up once so the
        // field shows a name, not just an opaque identifier.
        if (labelEl && hiddenInput.value) {
          const lookupUrl = `/cbgp/reference/label/${encodeURIComponent(targetForm)}` +
            `?via=${encodeURIComponent(via)}&label_method=${encodeURIComponent(labelMeth)}&value=${encodeURIComponent(hiddenInput.value)}`;
          fetch(lookupUrl)
            .then(r => r.json())
            .then(data => { if (data.label) labelEl.textContent = `(${data.label})`; })
            .catch(err => console.error('[typeahead] label lookup failed:', err));
        }

        // The suggestion list (typeahead.js) shows exactly what the server returns -
        // matched ignoring accents, shown as "Surname(s), Name" - and hands back the
        // chosen person, so two people who read alike are never mixed up.
        CBGPSuggest.attach(input, {
          fetchItems: function(query) {
            const url = `/cbgp/reference/suggest/${encodeURIComponent(targetForm)}` +
              `?q=${encodeURIComponent(query)}&via=${encodeURIComponent(via)}&label_method=${encodeURIComponent(labelMeth)}`;
            return fetch(url).then(r => r.json());
          },
          onPick: function(item) {
            input.value = item.label;
            setStoredValue(item.value, item.label);
          }
        });
      }

      // Initialise all server-rendered rows
      <% stored_values.each_index do |idx| %>
      initXrefRow(<%= idx %>);
      <% end %>

      <% if is_multi %>
      // "Add another" builds a fresh row in HTML, appends it, then initialises it
      document.getElementById('<%= qid %>_add_btn').addEventListener('click', function() {
        const container = document.getElementById(qid + '_container');
        const suffix    = parseInt(container.dataset.rowCount);
        container.dataset.rowCount = suffix + 1;

        const row = document.createElement('div');
        row.className = 'xref-row';
        row.id = qid + '_row_' + suffix;
        row.innerHTML = `
          <div>
            <input type="text" id="${qid}_SEARCH_${suffix}"
                   placeholder="${xrefHint}"
                   size="50" autocomplete="off">
            <button type="button" onclick="this.closest('.xref-row').remove()" style="font-size:0.8em; margin-left:4px;">− <%= CGI.escapeHTML(ui_text('typeahead.remove')) %></button>
          </div>
          <div id="${qid}_stored_row_${suffix}" style="display:none; margin-top:4px;">
            <small><%= CGI.escapeHTML(ui_text('typeahead.stored_value')) %>:&nbsp;</small>
            <code id="${qid}_DISPLAY_${suffix}"></code>
            <span id="${qid}_LABEL_${suffix}" class="xref-label"></span>
            <button type="button" id="${qid}_CLEAR_${suffix}" style="margin-left:6px; font-size:0.8em;">✕ <%= CGI.escapeHTML(ui_text('typeahead.clear')) %></button>
          </div>
          <input type="hidden" name="${qid}[]" id="${qid}_ANSWER_${suffix}" value="">`;

        container.appendChild(row);
        initXrefRow(suffix);   // fresh suggestion list, fresh listeners
      });
      <% end %>
    })();
    </script>

  <% end %>
</div>
