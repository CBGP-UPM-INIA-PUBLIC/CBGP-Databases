<% 
  # Initialize start and end values as empty strings for the initial search form
  start_date_value = ""
  end_date_value = ""
  start_today = false
  end_today = false
  
  # If @thisval contains a range (e.g., "2020-01-01 to 2025-12-31"), split it
  if @thisval.is_a?(String) && @thisval.include?(" to ")
    start_date, end_date = @thisval.split(" to ").map(&:strip)
    start_date_value = extract_date(start_date).match(/\d{4}-\d{2}-\d{2}/) ? extract_date(start_date) : ""
    end_date_value = extract_date(end_date).match(/\d{4}-\d{2}-\d{2}/) ? extract_date(end_date) : ""
    start_today = start_date.to_s.casecmp?("today")
    end_today = end_date.to_s.casecmp?("today")
  end
%>

<%# A "today" tick box sits beside each bound: it sends the word today instead of a date, which the
    search reads as the day it is run (so a saved link means "as of when it is opened"). It shares the
    date box's name; the box is greyed out (and so not sent) while it is ticked - see today.js.
    Without script, both are sent and the tick box, being later, wins. %>
<div class="inputtype">
  <span class="date-bound">
    <label for="<%= @answerblock.ablockid %>_start" style="font-size: .75em;">Start Date</label><br/>
    <input type="date" name="<%= @question.questionid %>[start]" id="<%= @answerblock.ablockid %>_start" value="<%= start_date_value %>"<%= start_today ? ' disabled' : '' %>>
    <label class="today-toggle"><input type="checkbox" name="<%= @question.questionid %>[start]" value="today" data-date-input="<%= @answerblock.ablockid %>_start"<%= start_today ? ' checked' : '' %>> <%= CGI.escapeHTML(ui_text('search.today')) %></label>
  </span>
  <span class="date-bound">
    <label for="<%= @answerblock.ablockid %>_end" style="font-size: .75em;">End Date</label><br/>
    <input type="date" name="<%= @question.questionid %>[end]" id="<%= @answerblock.ablockid %>_end" value="<%= end_date_value %>"<%= end_today ? ' disabled' : '' %>>
    <label class="today-toggle"><input type="checkbox" name="<%= @question.questionid %>[end]" value="today" data-date-input="<%= @answerblock.ablockid %>_end"<%= end_today ? ' checked' : '' %>> <%= CGI.escapeHTML(ui_text('search.today')) %></label>
  </span>
</div>

<% 
  # Define extract_date method if not already available (stub for now)
  def extract_date(date_str)
    Date.parse(date_str).strftime("%Y-%m-%d") rescue ""
  end
%>