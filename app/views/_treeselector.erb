<% unique_id = @question.questionid.to_s.gsub(/[^\w-]/, '_') %>

<!-- Current selection display (if editing) -->
<% if @thisval.to_s.strip != '' %>
  <% current_label = CBGP::Dataset.find_label_by_id(@hierarchical_data, @thisval.to_s) %>
  <% if current_label %>
    <div style="margin-bottom: 10px; padding: 8px; background-color: #f0f0f0; border-left: 4px solid #7b1fa2; font-weight: bold; color: #114203;">
      Current selection: <%= current_label %>
    </div>
  <% else %>
    <div style="margin-bottom: 10px; padding: 8px; background-color: #fff0f0; color: #c00;">
      Current selection ID: <%= @thisval %> (label not found in tree – possible data inconsistency)
    </div>
  <% end %>
<% end %>

<div id="treewidget-<%= unique_id %>" style="grid-column: 1 / -1; width: 100%; padding-left: 0 !important; margin-left: 0 !important; border-left: none !important; text-align: left !important;">
  <input type="text" id="tree-search-<%= unique_id %>" placeholder="Search categories..." style="margin-bottom: 10px; width: 100%; padding: 8px;">
  <ul id="custom-tree-<%= unique_id %>" style="min-height: 200px; border: 1px solid #ccc; padding: 10px 10px 10px 0 !important; margin: 0 !important; list-style: none !important; font-family: Arial, sans-serif; text-align: left !important;">
    <!-- Tree nodes rendered here -->
  </ul>
  <input type="hidden" name="<%= @question.questionid %>" id="selected-value-<%= unique_id %>" value="<%= @thisval %>">

  <style>
    /* Critical: scoped hidden rule (this was missing before) */
    #custom-tree-<%= unique_id %> .hidden { display: none !important; }

    /* Background reset for all li (prevents inherited backgrounds from bleeding) */
    #custom-tree-<%= unique_id %> li {
      background-color: transparent !important;
      border-left: none !important;
      box-shadow: none !important;
    }

    #treewidget-<%= unique_id %> { background-color: transparent !important; }
    #custom-tree-<%= unique_id %>, #custom-tree-<%= unique_id %> li, #custom-tree-<%= unique_id %> .node-text {
      text-align: left !important; font-weight: normal !important; margin-left: 0 !important; padding-left: 0 !important;
    }
    #custom-tree-<%= unique_id %> li {
      cursor: pointer; padding: 4px 8px; border-radius: 4px; transition: all 0.2s; position: relative;
    }
    #custom-tree-<%= unique_id %> li:hover { background: #f0f0f0 !important; box-shadow: none !important; }
    #custom-tree-<%= unique_id %> li.open { background: transparent !important; box-shadow: none !important; }
    #custom-tree-<%= unique_id %> .selected-check { box-shadow: 0 2px 8px rgba(123, 31, 162, 0.5) !important; z-index: 10 !important; margin: 1px !important; border: none !important; }
    #custom-tree-<%= unique_id %> li.search-match { background: yellow !important; color: black !important; box-shadow: none !important; }
    #custom-tree-<%= unique_id %> .expander { display: inline-block; width: 12px; margin-right: 5px; font-weight: bold; color: #666; user-select: none; }
    #custom-tree-<%= unique_id %> .expander:after { content: '▸'; }
    #custom-tree-<%= unique_id %> li.open .expander:after { content: '▽'; }
    #custom-tree-<%= unique_id %> ul { padding-left: 20px; border-left: 1px dashed #ddd; margin: 0; }
    #custom-tree-<%= unique_id %> .check-icon { color: #e1bee7 !important; font-weight: bold !important; margin-right: 4px !important; font-size: 1.2em !important; }
    #custom-tree-<%= unique_id %> li.single-selected {
      background-color: #d4e157 !important; border-left: 4px solid #7b1fa2 !important; box-shadow: 0 2px 4px rgba(123, 31, 162, 0.5) !important;
      color: #114203 !important; font-weight: bold !important; transition: all 0.2s !important;
    }
    #custom-tree-<%= unique_id %> li.single-selected:before { content: "✓ "; color: #7b1fa2 !important; font-weight: bold !important; margin-right: 5px !important; }
    #custom-tree-<%= unique_id %> li:hover { background-color: #f0f0f0 !important; }
    #custom-tree-<%= unique_id %> li.single-selected:hover { background-color: #d4e157 !important; }
  </style>

  <script>
    var $j = jQuery.noConflict();
    $j(function() {
      var treeData = <%= @hierarchical_data.to_json %>;
      var $tree = $j('#custom-tree-<%= unique_id %>');
      var $search = $j('#tree-search-<%= unique_id %>');
      var $selected = $j('#selected-value-<%= unique_id %>');

      // Sorting and validation (exactly as original)
      treeData.sort(function(a, b) {
        var seqDiff = (a.sequence || 0) - (b.sequence || 0);
        return seqDiff !== 0 ? seqDiff : a.text.localeCompare(b.text);
      });
      console.log('Sorted roots:', treeData.map(n => n.text)); // optional debug

      function validateNode(node, index, parentPath) {
        if (!node.id || typeof node.id !== 'string' || !node.text) {
          console.error('Invalid node at ' + parentPath + '[' + index + ']:', node);
          throw new Error('Node missing id or text');
        }
        if (node.children) {
          node.children.forEach(function(child, childIndex) {
            validateNode(child, childIndex, parentPath + '[' + index + '].children');
          });
        }
      }
      treeData.forEach(function(node, index) { validateNode(node, index, 'treeData'); });

      // Render tree recursively
      function renderNode(node, parentUl, depth = 0) {
        if (node.children) {
          node.children.sort(function(a, b) {
            var seqDiff = (a.sequence || 0) - (b.sequence || 0);
            return seqDiff !== 0 ? seqDiff : a.text.localeCompare(b.text);
          });
        }
        var li = $j('<li>').attr('data-id', node.id);
        if (depth > 0) li.addClass('hidden');
        if (depth === 0) li.addClass('root');
        var expander = node.children && node.children.length > 0 ? '<span class="expander"></span>' : '';
        li.html(expander + '<span class="node-text">' + $j('<div>').text(node.text).html() + '</span>');
        parentUl.append(li);
        if (node.children) {
          var childUl = $j('<ul>').addClass('hidden');
          li.append(childUl);
          node.children.forEach(function(child) { renderNode(child, childUl, depth + 1); });
          li.addClass('has-children');
        }
        return li;
      }

      // Build tree
      treeData.forEach(function(node) { renderNode(node, $tree); });

      // FORCE initial collapse – exactly your original lines
      $tree.find('ul').addClass('hidden');
      $tree.find('li:not(.root)').addClass('hidden');
      $tree.find('li.root').removeClass('hidden open');

      // Expander click
      $tree.on('click', '.expander', function(e) {
        e.stopPropagation();
        e.preventDefault();
        $tree.find('li').removeClass('single-selected');
        var $li = $j(this).closest('li');
        var $childUl = $li.children('ul');
        if ($li.hasClass('open')) {
          $childUl.addClass('hidden').find('li').addClass('hidden');
          $li.removeClass('open');
        } else {
          function showDescendants($ul) {
            $ul.removeClass('hidden').find('> li').removeClass('hidden');
            $ul.find('> li.has-children > ul').each(function() { showDescendants($j(this)); });
          }
          showDescendants($childUl);
          $li.addClass('open');
        }
      });

      // Node selection
      $tree.on('click', 'li', function(e) {
        if ($j(e.target).hasClass('expander')) return;
        $tree.find('li').removeClass('single-selected');
        $j(this).addClass('single-selected');
        var nodeId = $j(this).data('id');
        $selected.val(nodeId);
        e.stopPropagation();
      });

      // Search (debounced)
      var searchTimeout;
      $search.on('keyup', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
          var query = $j.trim($search.val().toLowerCase());
          $tree.find('li').removeClass('search-match open single-selected');
          $tree.find('ul').addClass('hidden');
          $tree.find('li:not(.root)').addClass('hidden');
          $tree.find('li.root').removeClass('hidden');
          if (!query) return;

          function searchNodes(nodes, $parentLi) {
            var found = false;
            nodes.forEach(function(node) {
              var $li = $parentLi.find('li[data-id="' + node.id + '"]');
              var text = node.text.toLowerCase();
              if (text.includes(query)) {
                $li.removeClass('hidden').addClass('search-match');
                var $current = $parentLi;
                while ($current.length) {
                  $current.removeClass('hidden').addClass('open');
                  $current.children('ul').removeClass('hidden');
                  $current = $current.parent().closest('li');
                }
                $li[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                found = true;
              }
              if (node.children) {
                var childFound = searchNodes(node.children, $li);
                if (childFound) { $li.removeClass('hidden').addClass('open'); $li.children('ul').removeClass('hidden'); found = true; }
              }
            });
            return found;
          }
          searchNodes(treeData, $tree);
        }, 300);
      });
    });
  </script>
</div>