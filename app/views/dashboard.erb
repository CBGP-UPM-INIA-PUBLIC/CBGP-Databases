<!DOCTYPE html>
<!--[if lt IE 7]> <html class="no-js ie6 oldie" lang="en"> <![endif]-->
<!--[if IE 7]>    <html class="no-js ie7 oldie" lang="en"> <![endif]-->
<!--[if IE 8]>    <html class="no-js ie8 oldie" lang="en"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js" lang="en"> <!--<![endif]-->

  <%= erb :_head %>

  <body>
    <%= erb :_logo_head %>

    <div style="clear: both;">
      <br/><br/>
      <h1>CBGP - Dashboard</h1>
      <br/>
    </div>

    <div class="databases" style="text-align: center;">
      <div style="float: right;">
        <!-- Optional: Add user info or logout -->
      </div>

      <!-- Loaders  -->
      <form action="/cbgp/loaders" method="POST" style="display: inline-block; margin-right: 20px;">
        <table id="load_data" width="30%">
          <tr><th>Data Loaders</th></tr>
          <tr><td>
            <% @loaders = ["DOI"] %>
            <select name="loader" id="select_loader">
              <% @loaders.each do |d| %>
                <option value="<%= d %>"><%= d %></option>
              <% end %>
            </select>
          </td></tr>
          <tr><td>
            <input type="submit" value="Load Data"/>
          </td></tr>
        </table>
      </form>

      <!-- Form for Adding New Data -->
      <form action="/cbgp/databases" method="POST" style="display: inline-block; margin-right: 20px;">
        <table id="add_new_data" width="30%">
          <tr><th>Add Data</th></tr>
          <tr><td>
            <select name="form" id="use_form">
              <% @databases.each do |d| %>
                <option value="<%= d[1] %>"><%= d[0] %></option>
              <% end %>
            </select>
          </td></tr>
          <tr><td>
            <input type="submit" value="Add Data"/>
          </td></tr>
        </table>
      </form>

      <!-- Form for Querying Existing Data (GET to search form) -->
      <form action="/cbgp/search-dataset" method="GET" style="display: inline-block;">
        <table id="query_existing_data" width="30%">
          <tr><th>Query Data</th></tr>
          <tr><td>
            <select name="database" id="query_database">
              <% @databases.each do |d| %>
                <option value="<%= d[1] %>"><%= d[0] %></option>
              <% end %>
            </select>
          </td></tr>
          <tr><td>
            <input type="submit" value="Query Data"/>
          </td></tr>
        </table>
      </form>
    </div>

    <div style="clear: both;">
      <center>
      <b>Enlaces para Gonzalo para documentos XML</b><br/><br/>
      <div style="color: white;">
        <a href="/cbgp/active-emails">Listo de Email</a><br/>
        <a href="/cbgp/active-members">Listo de Miembros</a>
        </div><br/>
      </center>
    </div>

    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
    <!--[if lt IE 7]>
      <script src="//ajax.googleapis.com/ajax/libs/chrome-frame/1.0.2/CFInstall.min.js"></script>
      <script>window.attachEvent("onload",function(){CFInstall.check({mode:"overlay"})})</script>
    <![endif]-->
  </body>
</html>