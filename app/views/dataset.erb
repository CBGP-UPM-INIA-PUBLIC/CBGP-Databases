
    <div class="databases">

    <!-- incoming @entry object and @questionnaire object -->

    <% if flash[:notice] %>
      <div class="flash-notice" role="status"><%= Rack::Utils.escape_html(flash[:notice]) %></div>
    <% end %>

    <% if session[:role] == 'admin' && @curation_targets && !@curation_targets.empty? %>
      <div class="flash-notice curation-panel" role="status">
        <strong><%= CGI.escapeHTML(ui_text('curate.panel_title')) %></strong>
        <%= CGI.escapeHTML(ui_text('curate.panel_body')) %>
        <% @curation_targets.each do |label, form| %>
          <a class="show-all-link" style="margin-left: 12px;" href="/cbgp/dataset/<%= ERB::Util.url_encode(form) %>/<%= ERB::Util.url_encode(@entry.primary_id.to_s) %>"><%= CGI.escapeHTML(label) %></a>
        <% end %>
      </div>
    <% end %>
    <% if @curating_from %>
      <div class="flash-notice curation-panel" role="status">
        <%= CGI.escapeHTML(ui_text('curate.notice', form: @curating_label.to_s)) %>
        <a class="show-all-link" style="margin-left: 12px;" href="/cbgp/dataset/<%= ERB::Util.url_encode(@curating_from) %>/<%= ERB::Util.url_encode(@entry.primary_id.to_s) %>"><%= CGI.escapeHTML(ui_text('curate.back')) %></a>
      </div>
      <% if @not_carried && !@not_carried.empty? %>
        <div class="flash-warning" role="alert">
          <%= CGI.escapeHTML(ui_text('curate.not_kept')) %>
          <ul>
            <% @not_carried.each do |label, shown| %>
              <li><strong><%= CGI.escapeHTML(label.to_s) %>:</strong> <%= CGI.escapeHTML(shown.to_s) %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

      <% if @validation_errors && @validation_errors.any? %>
        <div class="error-messages">
          <ul>
            <% @validation_errors.each do |err| %>
              <li><strong><%= err[:label] %>:</strong> <%= err[:message] %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <form action="/cbgp/validate-dataset/<%= @database %>" method="post">
        <table id="dataset_validate" width="80%">
          <tr> <th>Add/Edit <%= @database.capitalize %> Entry</th> </tr>
          <tr><td>
            <input type="submit" value="Submit <%= @database.capitalize %> Record"/>
            <input type="hidden" name="primary_id" value="<%= @entry.primary_id %>">
            <!-- @database (used in the URL/action above) is the dbname (e.g. "project") the
                 record is stored/looked up under; @form is the *specific* form class (e.g.
                 "personnel_project" vs "project") that was actually used to open this form.
                 Several forms can share one dbname, so the dbname alone can't tell the
                 server which one this was - only @form can. It's carried here, separately
                 from the URL, so the route can rebuild the right restricted questionnaire
                 on redisplay AND look up the right required-fields/defaults for THIS form,
                 not accidentally some other form that happens to share the same dbname. -->
            <input type="hidden" name="form_class" value="<%= @form %>">
          </td></tr>
          <tr> <td>
          <%= erb :_questionnaire %> 
          </td></tr>
          <tr><td>
            <input type="submit" value="Submit <%= @database.capitalize %>"/>
          </td></tr>
        </table>
      </form>

      <%= erb :_related_records %>

    </div>

