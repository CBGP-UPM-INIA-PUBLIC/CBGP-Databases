
    <div class="databases">

    <!-- incoming @entry object and @questionnaire object -->

    <% label1, label2 = ["Staff Member", "Name"] if @database =~ /member/ %>
    <% label1, label2 = ["Project", "Project CBGP ID"] if @database =~ /project/ %>

      <form action="/cbgp/dataset/<%= @database %>" method="POST">
      <table id="dataset_lookup" width="30%">
        <tr> <th>Add/Find <%= label1 %></th> </tr>
        <tr> <td>
          <label for='main_id'><%= label2 %> Lookup</label>
          <input type='text' name='main_id' id="main_id">
        </td></tr>
        <tr> <td>
          <input type="submit" value="Submit"/>
        </td></tr>
      </table>
      </form>

      <form action="/cbgp/validate-dataset/<%= @database %>" method="post">
        <table id="dataset_validate" width="30%">
          <tr> <th>Validate/Edit <%= label1 %></th> </tr>
          <tr><td>
            <input type="submit" value="Submit Edited <%= label1 %>"/>
          </td></tr>
          <tr> <td>
          <%= erb :_questionnaire %> 
          </td></tr>
          <tr><td>
            <input type="submit" value="Submit Edited <%= label1 %>"/>
          </td></tr>
        </table>
      </form>
 
    </div>

