<!DOCTYPE html>
<!--[if lt IE 7]> <html class="no-js ie6 oldie" lang="en"> <![endif]-->
<!--[if IE 7]>    <html class="no-js ie7 oldie" lang="en"> <![endif]-->
<!--[if IE 8]>    <html class="no-js ie8 oldie" lang="en"> <![endif]-->
<!--[if gt IE 8]><!--> <html class="no-js" lang="en"> <!--<![endif]-->
  
  <%= erb :_head %>

  <body>
  <script>
    function openActionPanel(cid) {
      var x = document.getElementById(cid);
      if (x.style.display === "none") {
        x.style.display = "block";
      } else {
        x.style.display = "none";
      }
    }
  </script>

  
      <%= erb :_logo_head %>



    <div style="clear: both;">
      <br/><br/>

      <h1>CBGP - Personnel Dashboard</h1>
      <br/>
    </div>
    <% if defined?(messages) && messages.any? %>
    <div class="error-messages">
      <ul>
        <% messages.each do |mes| %>
          <li><%= mes %></li>
        <% end %>
      </ul>
    </div>
    <% end %>

    <div class="databases">
    
      <form action="/cbgp/member" method="POST">
      <table id="member_lookup" width="30%">
        <tr> <th>Add/Find Staff Member</th> </tr>
        <tr> <td>
          <label for='staff_name'>Name Lookup</label>
          <input type='text' name='name' id="name">
        </td></tr>
        <tr> <td>
          <input type="submit" value="Submit"/>
        </td></tr>
      </table>
      </form>

      <form action="/cbgp/validate-member" method="post">
        <table id="member_validate" width="30%">
          <tr> <th>Validate/Edit Member</th> </tr>
          <tr><td>
            <input type="submit" value="Submit Edited Member"/>
          </td></tr>
          <tr> <td>
          <%= erb :_questionnaire %> 
          </td></tr>
          <tr><td>
            <input type="submit" value="Submit Edited Member"/>
          </td></tr>
        </table>
      </form>
 
    </div>


    <div style="clear: both;">
      <%= erb :_footer %>
    </div>


    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
    <!--[if lt IE 7]>
      <script src="//ajax.googleapis.com/ajax/libs/chrome-frame/1.0.2/CFInstall.min.js"></script>
      <script>window.attachEvent("onload",function(){CFInstall.check({mode:"overlay"})})</script>
    <![endif]-->
  </body>

</html>
