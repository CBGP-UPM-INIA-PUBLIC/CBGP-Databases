

    <div class="databases">
    
      <form action="/cbgp/publications" method="POST">
      <table id="publication_lookup" width="30%">
        <tr> <th>Add/Find Publication</th> </tr>
        <tr> <td>
          <label for='identifier'>DOI Lookup</label>
          <input type='text' name='identifier' id="identifier">
        </td></tr>
        <tr> <td>
          <input type="submit" value="Submit"/>
        </td></tr>
        <tr> <td>
          <a href="/cbgp/publications/bulk"><h4>Switch to Bulk Upload</h4></a>
        </td></tr>
      </table>
      </form>

      <form action="/cbgp/validate-dataset/<%= @database %>" method="post">
        <table id="dataset_validate" width="30%">
          <tr> <th>Validate Entry</th> </tr>
          <tr><td>
            <input type="submit" value="Submit Edited Record"/>
          </td></tr>
          <tr> <td>
            <div class="citation-box" style="border: 1px solid black; width: 700px; overflow: auto;">
              <b>Citation:</b><br/><pre><%= @entry.full_ref %></pre>
            </div>
          </td></tr>
          <tr> <td>
          <%= erb :_questionnaire %> 
          </td></tr>
          <tr><td>
            <input type="submit" value="Submit Edited Record"/>
          </td></tr>
        </table>
      </form>
 
    </div>
