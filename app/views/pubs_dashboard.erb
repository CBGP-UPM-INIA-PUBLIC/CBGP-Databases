  <script>
    function openActionPanel(cid) {
      var x = document.getElementById(cid);
      if (x.style.display === "none") {
        x.style.display = "block";
      } else {
        x.style.display = "none";
      }
    }
  </script>

  
      <%= erb :_logo_head %>



    <div style="clear: both;">
      <br/><br/>

      <h1>CBGP - Publications Dashboard</h1>
      <br/>
    </div>

    <div class="databases">
    
      <form action="/cbgp/publications" method="POST">
      <table id="publication_lookup" width="30%">
        <tr> <th>Add/Find Publication</th> </tr>
        <tr> <td>
          <label for='doi'>DOI Lookup</label>
          <input type='text' name='doi' id="doi">
        </td></tr>
        <tr> <td>
          <input type="submit" value="Submit"/>
        </td></tr>
      </table>
      </form>

      <% if @pub %>
        <form action="/cbgp/validate-publication" method="post">
        <table id="publication_validate" width="30%">
          <tr> <th>Validate/Edit Publication</th> </tr>
          <tr><td>
            <input type="submit" value="Submit Edited Publication"/>
          </td></tr>
          <tr> <td>
          <%= erb :_questionnaire %> 
          </td></tr>
          <tr><td>
            <input type="submit" value="Submit Edited Publication"/>
          </td></tr>
        </table>
        </form>
      <% end %>

    </div>


    <div style="clear: both;">
      <%= erb :_footer %>
    </div>


    <script src="http://ajax.googleapis.com/ajax/libs/jquery/1/jquery.min.js"></script>
