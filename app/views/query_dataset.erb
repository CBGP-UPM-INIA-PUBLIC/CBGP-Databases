<div id="databases">
  <h3>Search Results</h3>
  <% if @dataset_details.empty? %>
    <div class="error-messages">
      <p>No results found for your search.</p>
    </div>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>Dataset ID</th>
          <% @fields.each do |field| %>
            <th><%= field[:label] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @dataset_details.each do |dataset| %>
          <tr>
            <td><%= dataset[:dataset].split('/').last %></td>
            <% @fields.each do |field| %>
            <% warn "#{field[:fieldid]} = #{dataset[field[:fieldid].to_sym]}" %>
              <td><%= dataset[field[:fieldid].to_sym] || '-' %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>