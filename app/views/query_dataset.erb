<div class="databases">
  <h3>Search <%= @database =~ /member/ ? "Staff Members" : "Projects" %></h3>

  <form action="/cbgp/query-dataset/<%= @database %>" method="post">
    <table id="dataset_search" width="30%">
      <tr><th>Search Criteria</th></tr>
      <tr><td><%= erb :_questionnaire %></td></tr>
      <tr><td><input type="submit" value="Search"/></td></tr>
    </table>
  </form>

  <% if @results && @results.any? %>
    <h4>Matching Records</h4>
    <ul>
      <% @results.each do |graph_uri| %>
        <li><a href="/cbgp/view-dataset/<%= @database %>?graph=<%= graph_uri %>"><%= graph_uri %></a></li>
      <% end %>
    </ul>
  <% end %>
</div>