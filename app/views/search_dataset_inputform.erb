<div class="databases">
  <h2>Search <%= CGI.escapeHTML(shared_dbname?(@database) ? dbname_label(@database) : @database.to_s) %></h2>
  <p class="search-show-all">
    <a class="show-all-link" href="/cbgp/query-dataset/<%= Rack::Utils.escape_path(@database.to_s) %>?__all=1"><%= CGI.escapeHTML(ui_text('search.show_all')) %></a>
  </p>

  <form action="/cbgp/query-dataset/<%= @database %>" method="post">
    <table id="dataset_search" width="80%">
      <tr><th>Search Criteria</th></tr>
      <tr><td><input type="submit" value="Search"/></td></tr>
      <tr><td><%= erb :_questionnaire %></td></tr>
      <tr><td><input type="submit" value="Search"/></td></tr>
    </table>
  </form>
</div>