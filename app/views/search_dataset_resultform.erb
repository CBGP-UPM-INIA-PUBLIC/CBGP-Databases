<% 
# Compute TSV download data at the TOP of the template
# Generates tab-separated values for perfect Excel compatibility (avoids comma/locale issues)
require 'csv' 
require 'base64'

csv_data_uri = nil
csv_filename = nil

unless @datasets.empty?
  tsv_content = CSV.generate(col_sep: "\t", force_quotes: true) do |tsv|
    # Header: Dataset ID first, then all field labels
    tsv << ["Dataset ID"] + @fields.map { |f| f[:label] }
    
    # Rows
    @datasets.each do |dataset|
      row = [dataset.primary_id]
      
      @fields.each do |field|
        value = dataset.send(field[:objectmethod])
        
        cell = if value.nil? || (value.is_a?(Array) && value.empty?)
                 ''
               elsif value.is_a?(Array)
                 value.join(', ')  # Multi-valued still comma-separated inside the cell
               else
                 value.to_s
               end
        
        row << cell
      end
      
      tsv << row
    end
  end
  
  # Base64 for reliable data URI
  tsv_base64 = Base64.strict_encode64(tsv_content)
  csv_data_uri = "data:text/tab-separated-values;base64,#{tsv_base64}"
  
  # .tsv extension – Excel opens tabs perfectly with this
  csv_filename = "cbgp-search-results-#{@database}-#{Time.now.strftime('%Y-%m-%d')}.tsv"
end
%>

<div id="databases">
  <h3>
    Search Results
    <% unless @datasets.empty? %>
      <a href="<%= csv_data_uri %>" download="<%= csv_filename %>" class="download-csv-link">
        Download to Excel (TSV)
      </a>
    <% end %>
  </h3>
  
  <% if @datasets.empty? %>
    <div class="error-messages">
      <p>No results found for your search.</p>
    </div>
  <% else %>
    <!-- NEW: Form for multi-select delete -->
    <form action="/cbgp/query-dataset/<%= @database %>/delete-multiple" method="post" id="multi-delete-form">
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>
                <!-- Select All checkbox -->
                <input type="checkbox" id="select-all" />
              </th>
              <th>Action</th>
              <% @fields.each do |field| %>
                <th><%= field[:label] %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @datasets.each do |dataset| %>
              <tr>
                <td>
                  <input type="checkbox" name="selected_ids[]" value="<%= dataset.primary_id %>" class="select-item" />
                </td>
                <td class="dataset-id-cell">
                  <% primary_id = dataset.primary_id %>
                  <a href="/cbgp/dataset/<%= @database %>/<%= primary_id %>" class="dataset-link">
                    EDIT
                  </a>
                  - - 
                  <a href="/cbgp/dataset/delete/<%= @database %>/<%= primary_id %>"
                     class="dataset-link delete-link"
                     onclick="return confirm('Really delete this record? This cannot be undone.');">
                    DELETE
                  </a>
                </td>
                
                <% @fields.each do |field| %>
                  <td>
                    <% raw_value = dataset.send(field[:objectmethod]) %>
                    
                    <% if raw_value.nil? || (raw_value.is_a?(Array) && raw_value.empty?) %>
                      -
                    <% else %>
                      <% 
                        # Normalize to string: join arrays, to_s singles
                        display_value = if raw_value.is_a?(Array)
                                          raw_value.join(', ')
                                        else
                                          raw_value.to_s
                                        end
                        
                        # Truncate to ~100 characters (exact limit: 100)
                        # Only add "..." if actually truncated
                        truncated = display_value.length > 100 ? display_value[0...100] + '...' : display_value
                      %>
                      
                      <!-- Full value in title for tooltip on hover -->
                      <span title="<%= display_value %>">
                        <%= truncated %>
                      </span>
                    <% end %>
                  </td>
                <% end %>              
                </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Bulk delete button (disabled until items selected) -->
      <div style="margin-top: 20px; text-align: center;">
        <button type="submit" id="delete-selected-btn" disabled>
          Delete Selected
        </button>
      </div>
    </form>
  <% end %>
</div>

<script>
// Select All checkbox logic
document.getElementById('select-all').addEventListener('change', function(e) {
  document.querySelectorAll('.select-item').forEach(cb => {
    cb.checked = e.target.checked;
  });
  updateDeleteButton();
});

// Enable/disable bulk button based on selections
document.querySelectorAll('.select-item').forEach(cb => {
  cb.addEventListener('change', updateDeleteButton);
});

function updateDeleteButton() {
  const anyChecked = document.querySelector('.select-item:checked');
  const btn = document.getElementById('delete-selected-btn');
  btn.disabled = !anyChecked;
}

// Confirmation on bulk delete
document.getElementById('multi-delete-form').addEventListener('submit', function(e) {
  const checkedCount = document.querySelectorAll('.select-item:checked').length;
  if (checkedCount === 0 || !confirm(`Really delete ${checkedCount} selected record(s)? This cannot be undone.`)) {
    e.preventDefault();
  }
});
</script>