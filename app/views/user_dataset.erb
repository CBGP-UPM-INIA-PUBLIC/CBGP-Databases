
    <div class="databases">

    <!-- incoming @entry object and @questionnaire object -->

      <% if @validation_errors && @validation_errors.any? %>
        <div class="error-messages">
          <ul>
            <% @validation_errors.each do |err| %>
              <li><strong><%= err[:label] %>:</strong> <%= err[:message] %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <form action="/cbgp/validate-user-dataset/<%= @database %>" method="post">
        <table id="dataset_validate" width="80%">
          <tr> <th>Add/Edit <%= @database.capitalize %> Entry</th> </tr>
          <tr><td>
            <input type="submit" value="Submit <%= @database.capitalize %> Record"/>
            <input type="hidden" name="primary_id" value="<%= @entry.primary_id %>">
          </td></tr>
          <tr> <td>
          <%= erb :_questionnaire %> 
          </td></tr>
          <tr><td>
            <input type="submit" value="Submit <%= @database.capitalize %>"/>
          </td></tr>
        </table>
      </form>
 
    </div>

